<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="HotKeyBoxPkg"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Tony Stone"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="src"/>
        <OtherUnitFiles Value="src"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="THotKey: a shortcut entry box. Click it, press the keys, it shows Shift+Ctrl+F9. Delphi's class, types and defaults, drawn by the control itself. Plain LCL."/>
    <License Value="0BSD"/>
    <Version Minor="1"/>
    <Files Count="2">
      <Item1>
        <Filename Value="src/hotkeybox.pas"/>
        <UnitName Value="HotKeyBox"/>
      </Item1>
      <Item2>
        <Filename Value="src/hotkeyboxreg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="HotKeyBoxReg"/>
      </Item2>
    </Files>
    <RequiredPkgs Count="1">
      <Item1>
        <PackageName Value="LCL"/>
      </Item1>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
